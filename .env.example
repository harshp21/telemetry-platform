NODE_ENV=development
# Runtime connection. Least-privilege application role: NOSUPERUSER, NOBYPASSRLS, and not
# the owner of any table -- this is what makes the Postgres RLS policies actually enforce.
# Created by prisma/migrations/v1_4_app_role_non_superuser (and by the compose init script).
DATABASE_URL=postgresql://telemetry_app:telemetry_app_local_dev@localhost:5432/telemetry
# Migration/schema connection only (Prisma `directUrl`). Owns the tables and can CREATE ROLE,
# so it must never be the runtime connection. Leave unset in app runtime environments.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telemetry
REDIS_URL=redis://localhost:6379
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=info
# Shared service-to-service secret. Required by the gateway and usage-service env schemas,
# which fail fast at startup if it is missing or shorter than 32 characters.
INTERNAL_API_SECRET=dev-local-internal-secret-at-least-32-chars

# Usage Service — Redis Streams Configuration
REDIS_STREAM_NAME=telemetry:events          # Redis stream key for ingest events
STREAM_MAX_LEN=100000                       # Max entries in stream (auto-trimmed beyond this)
INGEST_BATCH_MAX=100                        # Max events per batch in ingestion pipeline (1–100)
