# Auth Service Environment Variables
# Copy this file to .env and update with your actual values

## Core Infrastructure
NODE_ENV=development
PORT=3001

## Database
# NOT YET FLIPPED TO THE LEAST-PRIVILEGE ROLE -- see S-7 in .claude/rules/known-gaps.md.
#
# Every other service runs as `telemetry_app` (NOSUPERUSER, NOBYPASSRLS) so RLS enforces.
# auth-service cannot yet, because its pre-authentication queries have no tenant to scope
# to and are therefore blocked by the RLS policies on "User" and "Tenant":
#   - findUserForLogin / duplicate-email check select by e-mail before a tenant is known
#     -> `USING ("tenantId" = current_setting('app.tenant_id', true))` matches nothing
#   - registration INSERTs a Tenant before any tenant context exists
#     -> ERROR: new row violates row-level security policy for table "Tenant"
# Flipping this line without first landing the S-7 fix breaks login and registration.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telemetry

## Cache
REDIS_URL=redis://localhost:6379

## Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=debug

## Security (SENSITIVE - change in production)
JWT_SECRET=your-jwt-secret-at-least-32-chars-long-change-this
JWT_REFRESH_SECRET=your-jwt-refresh-secret-at-least-32-chars-long-change-this
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
BCRYPT_ROUNDS=12

## Session & Cookie Configuration (optional - uses sensible defaults)
AUTH_REFRESH_COOKIE_NAME=refreshToken
AUTH_CSRF_COOKIE_NAME=csrfToken
AUTH_CSRF_HEADER_NAME=x-csrf-token
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=localhost
