# Auth Service Environment Variables
# Copy this file to .env and update with your actual values

## Core Infrastructure
NODE_ENV=development
PORT=3001

## Database
# Runtime connection. Least-privilege application role: NOSUPERUSER, NOBYPASSRLS, and not
# the owner of any table -- this is what makes the Postgres RLS policies actually enforce.
#
# auth-service does NOT use `telemetry_app`, the role the other five services share. Its
# pre-authentication lookups (login, the duplicate-email check, refresh rotation) reach the
# tenant through two SECURITY DEFINER resolvers that read past the "User" tenant policy by
# design, and EXECUTE on those is granted to `telemetry_auth_app` alone -- otherwise every
# service would hold an e-mail -> tenant oracle. Both roles are NOSUPERUSER NOBYPASSRLS, but this
# one holds LESS: DML on "Tenant", "User" and "RefreshToken" only, and no default privileges, so
# a future table has to be granted deliberately.
#
# `telemetry_auth_app` and the resolvers are created by
# prisma/migrations/v1_5_auth_tenant_resolvers, which must be applied BEFORE this service
# starts on this role, or login and registration fail. See
# docs/releases/s-007-auth-service-restricted-role.md.
DATABASE_URL=postgresql://telemetry_auth_app:telemetry_auth_app_local_dev@localhost:5432/telemetry
# Migration/schema connection only (Prisma `directUrl`). Owns the tables and can CREATE ROLE,
# so it must never be the runtime connection. Leave unset in app runtime environments.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/telemetry

## Cache
REDIS_URL=redis://localhost:6379

## Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=debug

## Security (SENSITIVE - change in production)
JWT_SECRET=your-jwt-secret-at-least-32-chars-long-change-this
JWT_REFRESH_SECRET=your-jwt-refresh-secret-at-least-32-chars-long-change-this
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
BCRYPT_ROUNDS=12

## Session & Cookie Configuration (optional - uses sensible defaults)
AUTH_REFRESH_COOKIE_NAME=refreshToken
AUTH_CSRF_COOKIE_NAME=csrfToken
AUTH_CSRF_HEADER_NAME=x-csrf-token
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=localhost
