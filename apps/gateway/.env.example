# Gateway Environment Variables
# Copy this file to .env and update with your actual values

## Core Infrastructure
NODE_ENV=development
PORT=3100

## Cache
REDIS_URL=redis://localhost:6379

## Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=debug

## Security (SENSITIVE - change in production)
JWT_SECRET=your-jwt-secret-at-least-32-chars-long-change-this

## Service Discovery
AUTH_SERVICE_URL=http://localhost:3001
USAGE_SERVICE_URL=http://localhost:3002
WORKER_SERVICE_URL=http://localhost:3003
BILLING_SERVICE_URL=http://localhost:3004
ANALYTICS_SERVICE_URL=http://localhost:3005

## Rate Limiting
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=1000
INGESTION_RATE_LIMIT_MAX=5000
